@model SIGEBI.AppWeb.Models.Solicitudes.RechazarSolicitudViewModel
@{
    ViewData["Title"] = "Rechazar Solicitud";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header bg-danger text-white py-4 px-4 text-center">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-x-octagon"></i> Denegar Solicitud</h3>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Rechazar" method="post">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger border-start border-danger border-4">
                                <div asp-validation-summary="All" class="mb-0 fw-semibold small"></div>
                            </div>
                        }

                        <div class="form-floating mb-4">
                            <input asp-for="IdSolicitud" class="form-control" placeholder="123" />
                            <label asp-for="IdSolicitud" class="text-muted">Número de Solicitud (ID)</label>
                        </div>

                        <div class="form-floating mb-4">
                            <textarea asp-for="MotivoRechazo" class="form-control" placeholder="Motivo..." style="height: 100px"></textarea>
                            <label asp-for="MotivoRechazo" class="text-muted">Motivo del rechazo</label>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-danger btn-lg fw-bold shadow-sm">
                                Confirmar Rechazo
                            </button>
                            <a asp-action="Index" class="btn btn-light mt-2 text-muted">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>