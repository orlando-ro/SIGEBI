@model IEnumerable<SIGEBI.AppWeb.Models.Solicitudes.SolicitudItemViewModel>
@{
    ViewData["Title"] = "Mis Solicitudes";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h1 class="fw-bold"><i class="bi bi-inbox text-primary"></i> Mis Solicitudes</h1>
        <a asp-action="Crear" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
            <i class="bi bi-cart-plus me-1"></i> Carrito
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm border-start border-danger border-5">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm border-0 border-top border-primary border-4">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-custom table-striped mb-0 align-middle text-center">
                        <thead class="py-3 bg-primary text-white">
                            <tr>
                                <th class="py-3 px-3">ID Solicitud</th>
                                <th class="py-3">Fecha de Envío</th>
                                <th class="py-3 text-start">Libros Solicitados</th>
                                <th class="py-3">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold px-3">#@item.IdSolicitud</td>
                                    <td>@item.FechaSolicitud.ToString("dd/MMM/yyyy HH:mm")</td>
                                    <td class="text-start">
                                        <ul class="mb-0 ps-3 small fw-semibold">
                                            @foreach (var titulo in item.TitulosLibros)
                                            {
                                                <li>@titulo</li>
                                            }
                                        </ul>
                                    </td>
                                    <td>
                                        @{
                                            string badgeClass = item.Estado == "Pendiente" ? "bg-warning text-dark" :
                                            (item.Estado == "Aprobada" ? "bg-success" : "bg-danger");
                                            string iconClass = item.Estado == "Pendiente" ? "bi-hourglass-split" :
                                            (item.Estado == "Aprobada" ? "bi-check-circle" : "bi-x-circle");
                                        }
                                        <span class="badge rounded-pill @badgeClass px-3 py-2 shadow-sm">
                                            <i class="bi @iconClass me-1"></i> @item.Estado
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center mt-5">
            <div class="col-md-8">
                <div class="card shadow-lg border-0 border-top border-secondary border-5 rounded-4 text-center p-5" style="background-color: var(--bg-card, #ffffff);">
                    <div class="display-1 text-muted opacity-50 mb-4">
                        <i class="bi bi-inbox"></i>
                    </div>
                    <h2 class="fw-bold mb-3">Historial Vacío</h2>
                    <p class="lead text-muted mb-4">Aún no has realizado ninguna solicitud de préstamos.</p>
                    <div>
                        <a asp-controller="Catalogo" asp-action="Index" class="btn btn-outline-primary rounded-pill px-5 py-2 fw-bold shadow-sm">
                            <i class="bi bi-search me-2"></i> Explorar Catálogo
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>