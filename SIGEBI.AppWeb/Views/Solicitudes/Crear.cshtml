@model SIGEBI.AppWeb.Models.Solicitudes.CrearSolicitudViewModel
@{
    ViewData["Title"] = "Confirmar Solicitud";
}

<div class="container mt-5 mb-5 text-white">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card border-0 rounded-4 overflow-hidden shadow-lg" style="background-color: #14213d;">

                <!-- 🔥 UX: Cabecera con botón de acceso al historial -->
                <div class="card-header py-4 px-4 border-0" style="background-color: #007bff;">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                        <div>
                            <h3 class="mb-0 fw-bold text-white"><i class="bi bi-journal-check me-2"></i> Confirmar Solicitud</h3>
                            <small class="text-white-50">Verifica los recursos seleccionados antes de enviar.</small>
                        </div>
                        <a asp-action="Index" class="btn btn-light text-primary btn-sm rounded-pill fw-bold shadow-sm px-4 py-2 d-flex align-items-center transition-hover">
                            <i class="bi bi-list-check fs-5 me-2"></i> Mis solicitudes pendientes
                        </a>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">

                    <!-- SECCIÓN DE CARGA -->
                    <div id="seccionAgradecimiento" class="d-none text-center py-5">
                        <div class="spinner-border text-primary mb-4" role="status" style="width: 4rem; height: 4rem; border-width: 0.3em;">
                            <span class="visually-hidden">Procesando...</span>
                        </div>
                        <h2 class="fw-bold">Procesando tu petición...</h2>
                        <p class="text-white-50 fs-5">Por favor, espera un momento mientras validamos la disponibilidad en el sistema.</p>
                    </div>

                    <!-- SECCIÓN FORMULARIO -->
                    <div id="seccionFormulario">
                        <form id="formSolicitud" asp-action="Crear" method="post">
                            @Html.AntiForgeryToken()

                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger shadow-sm border-start border-danger border-4 mb-4">
                                    <div asp-validation-summary="All" class="mb-0 text-danger fw-semibold small"></div>
                                </div>
                            }

                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-bold mb-0">Recursos en tu lista:</h5>
                                    <!-- BOTÓN PARA AGREGAR MÁS LIBROS DEL CATÁLOGO -->
                                    <a href="/Catalogo" class="btn btn-sm btn-outline-info rounded-pill fw-bold">
                                        <i class="bi bi-plus-circle me-1"></i> Agregar más libros
                                    </a>
                                </div>

                                <div id="vistaCarrito"></div>

                                <div class="d-none">
                                    <textarea asp-for="IsbnsIngresados" id="IsbnsIngresados" class="form-control"></textarea>
                                </div>
                                <span asp-validation-for="IsbnsIngresados" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-5">
                                <a asp-action="Index" class="text-white-50 text-decoration-none fw-semibold">
                                    <i class="bi bi-arrow-left me-1"></i> Cancelar
                                </a>
                                <!-- BOTÓN QUE DISPARA EL MODAL -->
                                <button type="button" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm fw-bold transition-hover" onclick="validarYMostrarModal()">
                                    <i class="bi bi-send-check me-2"></i> Enviar Solicitud
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL NATIVO DE BOOTSTRAP PARA CONFIRMACIÓN -->
<div class="modal fade" id="modalConfirmacion" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-white" style="background-color: #1a2a47; border: 1px solid #2a3b5c;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-warning" id="modalLabel"><i class="bi bi-exclamation-triangle-fill me-2"></i> ¿Estás seguro?</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3 pb-4">
                <p class="mb-0 fs-6">Una vez enviada la solicitud, pasará a estado de revisión. <strong>No podrás editarla ni agregar más libros a esta misma solicitud.</strong></p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-light rounded-pill px-4" data-bs-dismiss="modal">Revisar lista</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" onclick="ejecutarEnvioFinal()">Sí, Enviar Solicitud</button>
            </div>
        </div>
    </div>
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .transition-hover:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            sincronizarTextareaHaciaCarrito();
            renderizarCarrito();
        });

        function sincronizarTextareaHaciaCarrito() {
            const textarea = document.getElementById('IsbnsIngresados');
            let carrito = JSON.parse(localStorage.getItem('sigebi_carrito_solicitudes')) || [];

            if (carrito.length === 0 && textarea.value.trim() !== '') {
                const isbns = textarea.value.split(',').map(s => s.trim()).filter(s => s);
                carrito = isbns.map(isbn => ({ isbn: isbn, titulo: 'Recurso guardado (' + isbn + ')' }));
                localStorage.setItem('sigebi_carrito_solicitudes', JSON.stringify(carrito));
            }
        }

        function renderizarCarrito() {
            const contenedor = document.getElementById('vistaCarrito');
            const textarea = document.getElementById('IsbnsIngresados');
            let carrito = JSON.parse(localStorage.getItem('sigebi_carrito_solicitudes')) || [];

            textarea.value = carrito.map(l => l.isbn).join(', ');

            if (carrito.length === 0) {
                contenedor.innerHTML = `
                    <div class="text-center p-5 border rounded-4 border-secondary border-opacity-25 bg-dark bg-opacity-50">
                        <i class="bi bi-cart-x display-4 text-white-50 mb-3 d-block"></i>
                        <h5 class="fw-bold">Tu lista está vacía</h5>
                        <p class="text-white-50 small">Ve al catálogo para agregar recursos a tu solicitud.</p>
                        <a href="/Catalogo" class="btn btn-outline-primary rounded-pill px-4 mt-3 fw-semibold shadow-sm transition-hover">Explorar Catálogo</a>
                    </div>
                `;
                return;
            }

            let html = '<div class="list-group shadow-sm border-0 rounded-4 overflow-hidden">';
            carrito.forEach((libro, index) => {
                html += `
                    <div class="list-group-item d-flex justify-content-between align-items-center p-3" style="background-color: #0d1b2a; border-color: #2a3b5c; color: white;">
                        <div>
                            <h6 class="mb-1 fw-bold"><i class="bi bi-book text-primary me-2"></i>${libro.titulo}</h6>
                            <small class="text-white-50 font-monospace"><i class="bi bi-upc-scan me-1"></i>${libro.isbn}</small>
                        </div>
                        <button type="button" onclick="eliminarDelCarrito(${index})" class="btn btn-sm btn-outline-danger rounded-circle shadow-sm transition-hover" title="Quitar recurso">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                `;
            });
            html += '</div>';
            contenedor.innerHTML = html;
        }

        function eliminarDelCarrito(index) {
            let carrito = JSON.parse(localStorage.getItem('sigebi_carrito_solicitudes')) || [];
            carrito.splice(index, 1);
            localStorage.setItem('sigebi_carrito_solicitudes', JSON.stringify(carrito));
            renderizarCarrito();
        }

        function validarYMostrarModal() {
            let carrito = JSON.parse(localStorage.getItem('sigebi_carrito_solicitudes')) || [];
            if (carrito.length === 0) {
                alert("Tu lista está vacía. Selecciona recursos del catálogo.");
                return;
            }
            var myModal = new bootstrap.Modal(document.getElementById('modalConfirmacion'));
            myModal.show();
        }

        function ejecutarEnvioFinal() {
            var modalEl = document.getElementById('modalConfirmacion');
            var modalInstance = bootstrap.Modal.getInstance(modalEl);
            modalInstance.hide();

            document.getElementById('seccionFormulario').classList.add('d-none');
            document.getElementById('seccionAgradecimiento').classList.remove('d-none');

            localStorage.removeItem('sigebi_carrito_solicitudes');

            setTimeout(() => {
                const form = document.getElementById('formSolicitud');
                HTMLFormElement.prototype.submit.call(form);
            }, 800);
        }
    </script>
}