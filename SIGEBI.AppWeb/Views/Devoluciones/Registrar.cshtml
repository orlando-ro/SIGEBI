@model SIGEBI.AppWeb.Models.Devoluciones.RegistrarDevolucionViewModel
@using SIGEBI.Domain.Enums

@{
    ViewData["Title"] = "Procesar Devolución";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header bg-gradient-custom py-4 px-4">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-arrow-return-left"></i> Recepción de Préstamo</h3>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Registrar" method="post">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger shadow-sm border-start border-danger border-4">
                                <div asp-validation-summary="All" class="mb-0 text-danger fw-semibold small"></div>
                            </div>
                        }

                        <div class="form-floating mb-4">
                            <input asp-for="IdPrestamo" class="form-control" placeholder="Ej: 154" autocomplete="off" />
                            <label asp-for="IdPrestamo"><i class="bi bi-hash"></i> Número de Préstamo</label>
                            <span asp-validation-for="IdPrestamo" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <select asp-for="CondicionLibro" class="form-control" asp-items="Html.GetEnumSelectList<CondicionDevolucion>()">
                                <option value="" selected disabled>Seleccione una condición...</option>
                            </select>
                            <label asp-for="CondicionLibro"><i class="bi bi-clipboard-check"></i> Condición del Recurso</label>
                            <span asp-validation-for="CondicionLibro" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <textarea asp-for="Observaciones" class="form-control" style="height: 100px" placeholder="Detalles extra..."></textarea>
                            <label asp-for="Observaciones"><i class="bi bi-chat-text"></i> Observaciones (Opcional)</label>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-5">
                            <a asp-action="Index" class="text-muted text-decoration-none"><i class="bi bi-arrow-left"></i> Cancelar</a>
                            <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm fw-bold">
                                Procesar y Verificar Multas
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>