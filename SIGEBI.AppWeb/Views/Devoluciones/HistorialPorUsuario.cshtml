@model IEnumerable<SIGEBI.AppWeb.Models.Devoluciones.DevolucionItemViewModel>
@{
    ViewData["Title"] = "Historial de Devoluciones";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <div>
            <h2 class="fw-bold text-success"><i class="bi bi-journal-check"></i> Historial de Devoluciones</h2>
            @if (ViewBag.Busqueda != null)
            {
                <p class="text-muted mb-0">Resultados para: <strong>@ViewBag.Busqueda</strong></p>
            }
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">Volver</a>
    </div>

    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning border-start border-warning border-5 shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["WarningMessage"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-custom table-striped mb-0 text-center align-middle">
                        <thead class="py-3 bg-success text-white">
                            <tr>
                                <th class="py-3">Devolución</th>
                                <th class="py-3">Préstamo</th>
                                <th class="py-3">Usuario</th>
                                <th class="py-3">Fecha</th>
                                <th class="py-3">Condición</th>
                                <th class="py-3">Retraso</th>
                                <th class="py-3">Penalización</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">#@item.IdDevolucion</td>
                                    <td class="text-muted">#@item.IdPrestamo</td>
                                    <td class="fw-semibold">@item.NombreUsuario</td>
                                    <td>@item.FechaDevolucion.ToString("dd/MMM/yyyy")</td>
                                    <td>
                                        <span class="badge bg-secondary">@item.CondicionLibro</span>
                                    </td>
                                    <td>
                                        @if (item.DiasRetraso > 0)
                                        {
                                            <span class="text-danger fw-bold">@item.DiasRetraso días</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Ninguno</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.GeneroPenalizacion)
                                        {
                                            <i class="bi bi-check-circle-fill text-danger fs-5"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-dash-circle text-muted"></i>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (ViewBag.Busqueda != null && TempData["WarningMessage"] == null)
    {
        <div class="text-center py-5">
            <h4 class="text-muted">No se encontraron devoluciones registradas.</h4>
        </div>
    }
</div>