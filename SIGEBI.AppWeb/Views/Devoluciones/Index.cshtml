@{
    ViewData["Title"] = "Módulo de Devoluciones";
    var rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    bool esBibliotecario = rolUsuario == "PersonalBibliotecario";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h1 class="fw-bold"><i class="bi bi-box-arrow-in-left text-primary"></i> Módulo de Devoluciones</h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4 mb-4">
        @if (esBibliotecario)
        {
            <div class="col-12">
                <div class="card shadow p-3 border-start border-primary border-5 transition-hover">
                    <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <h4 class="card-title fw-bold">Registrar Nueva Devolución</h4>
                            <p class="card-text text-muted mb-0">Recepcona los libros, verifica su estado y calcula penalizaciones automáticamente si aplica.</p>
                        </div>
                        <a asp-action="Registrar" class="btn btn-primary btn-lg px-5 rounded-pill shadow">
                            <i class="bi bi-arrow-return-left me-2"></i> Procesar Devolución
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm transition-hover">
                <div class="card-header bg-transparent border-0 pt-4 pb-0">
                    <h5 class="fw-bold text-success"><i class="bi bi-person-lines-fill me-2"></i> Historial por Usuario</h5>
                </div>
                <div class="card-body">
                    <form asp-action="HistorialPorUsuario" method="get">
                        <div class="input-group mb-3 shadow-sm">
                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" name="identificador" required placeholder="Ej: Matrícula o Empleado" />
                            <button class="btn btn-success px-4" type="submit">Buscar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 shadow-sm transition-hover">
                <div class="card-header bg-transparent border-0 pt-4 pb-0">
                    <h5 class="fw-bold text-info"><i class="bi bi-journal-text me-2"></i> Historial por Recurso (Libro)</h5>
                </div>
                <div class="card-body">
                    <form asp-action="HistorialPorRecurso" method="get">
                        <div class="input-group mb-3 shadow-sm">
                            <span class="input-group-text bg-white"><i class="bi bi-upc-scan"></i></span>
                            <input type="text" class="form-control" name="isbnLibro" required placeholder="Ej: Código ISBN del Libro" />
                            <button class="btn btn-info text-white px-4" type="submit">Buscar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .transition-hover { transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out; }
    .transition-hover:hover { transform: translateY(-4px); box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important; }
</style>