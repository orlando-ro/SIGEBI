<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIGEBI</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SIGEBI.AppWeb.styles.css" asp-append-version="true" />

    <!-- Script Global para cambiar el tema antes de renderizar la página -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('sigebi-theme') || 'light';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg shadow-sm mb-4" style="background-color: var(--theme-primary, #f8f9fa); transition: background-color 0.3s ease;">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half"></i> SIGEBI
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Inicio
                            </a>
                        </li>

                        @if (User.Identity!.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold" asp-area="" asp-controller="Prestamos" asp-action="Index">
                                    <i class="bi bi-journal-bookmark"></i> Préstamos
                                </a>
                            </li>

                            <!-- ENLACE DE SOLICITUDES ACTUALIZADO -->
                            <li class="nav-item">
                                <a class="nav-link fw-semibold" asp-area="" asp-controller="Solicitudes" asp-action="Index">
                                    <i class="bi bi-inbox"></i> Solicitudes
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Controles a la derecha (Temas y Usuario) -->
                    <ul class="navbar-nav align-items-center">

                        <!-- Selector de Temas Global -->
                        <li class="nav-item me-4">
                            <div class="btn-group shadow-sm" role="group" aria-label="Selector de temas">
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setTheme('light')" title="Modo Claro">☀️</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setTheme('warm-dark')" title="Nocturno Cálido">🌙</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setTheme('ocean')" title="Azul Institucional">🌊</button>
                            </div>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle fw-bold" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle"></i> @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="navbarDropdown">
                                    <li><span class="dropdown-item-text text-muted small">Rol: @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Acceso" asp-action="Salir">
                                            <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary text-white px-4 rounded-pill shadow-sm" asp-controller="Acceso" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-3">
        <div class="container text-center">
            &copy; 2026 - SIGEBI (Sistema de Gestión de Bibliotecas) - Proyecto ITLA
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Script Global para cambiar el tema dinámicamente -->
    <script>
        function setTheme(themeName) {
            document.documentElement.setAttribute('data-theme', themeName);
            localStorage.setItem('sigebi-theme', themeName);
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>