<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIGEBI</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SIGEBI.AppWeb.styles.css" asp-append-version="true" />

    <script>
            (function() {
                const savedTheme = localStorage.getItem('sigebi-theme') || 'light';
                document.documentElement.setAttribute('data-theme', savedTheme);
            })();
    </script>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg shadow-sm mb-4 py-3" style="background-color: var(--theme-primary, #f8f9fa); transition: background-color 0.3s ease;">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half text-primary"></i> <span>SIGEBI</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-lg-center ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-2" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Inicio
                            </a>
                        </li>

                        @if (User.Identity!.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold text-primary px-2" asp-area="" asp-controller="Catalogo" asp-action="Index">
                                    <i class="bi bi-collection-fill me-1"></i> Catálogo
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-semibold px-2" asp-area="" asp-controller="Prestamos" asp-action="Index">
                                    <i class="bi bi-journal-bookmark me-1"></i> Préstamos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-semibold px-2" asp-area="" asp-controller="Solicitudes" asp-action="Index">
                                    <i class="bi bi-inbox me-1"></i> Solicitudes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-semibold text-danger px-2" asp-area="" asp-controller="Penalizaciones" asp-action="Index">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Penalizaciones
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center gap-3 mt-3 mt-lg-0">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <!-- Campanita de Notificaciones -->
                            <li class="nav-item">
                                <a class="btn btn-outline-warning border-0 rounded-circle shadow-sm position-relative d-flex align-items-center justify-content-center notification-bell" style="width: 40px; height: 40px;" asp-controller="Notificaciones" asp-action="Index" title="Mis Notificaciones">
                                    <i class="bi bi-bell-fill fs-5"></i>
                                </a>
                            </li>
                        }

                        <!-- Selector de Temas -->
                        <li class="nav-item">
                            <div class="btn-group shadow-sm" role="group" aria-label="Selector de temas">
                                <button type="button" class="btn btn-sm btn-outline-secondary px-2" onclick="setTheme('light')" title="Modo Claro">☀️</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary px-2" onclick="setTheme('warm-dark')" title="Nocturno Cálido">🌙</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary px-2" onclick="setTheme('ocean')" title="Azul Institucional">🌊</button>
                            </div>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            var nombreUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                                             ?? User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value
                                             ?? User.FindFirst("Nombre")?.Value
                                             ?? User.Identity?.Name
                                             ?? "Usuario";

                            <li class="nav-item dropdown ms-2">
                                <a class="nav-link dropdown-toggle fw-bold d-flex align-items-center gap-2" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <!-- Círculo azul con el icono de usuario -->
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 32px; height: 32px;">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <!-- Nombre en texto -->
                                    <span>@nombreUsuario</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2 p-2" aria-labelledby="navbarDropdown">
                                    <li><span class="dropdown-item-text text-muted small">Rol: <strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</strong></span></li>
                                    <li><hr class="dropdown-divider"></li>

                                    <!-- Botón de Mi Perfil -->
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2" asp-controller="Perfil" asp-action="Index">
                                            <i class="bi bi-person-badge text-primary me-2"></i> Mi Perfil
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item text-danger rounded-3 py-2 mt-1" asp-controller="Acceso" asp-action="Salir">
                                            <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary text-white px-4 rounded-pill shadow-sm fw-bold" asp-controller="Acceso" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-5 mb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top text-muted mt-auto py-4" style="background-color: var(--bg-card);">
        <div class="container text-center small">
            &copy; 2026 - SIGEBI (Sistema de Gestión de Bibliotecas) - Proyecto ITLA
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            function setTheme(themeName) {
                document.documentElement.setAttribute('data-theme', themeName);
                localStorage.setItem('sigebi-theme', themeName);
            }
    </script>

    <style>
            .notification-bell {
                background-color: rgba(255, 193, 7, 0.15);
                color: #ffc107 !important;
                transition: all 0.2s ease-in-out;
            }

                .notification-bell:hover {
                    background-color: #ffc107 !important;
                    color: #212529 !important;
                    transform: scale(1.05);
                }
    </style>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>