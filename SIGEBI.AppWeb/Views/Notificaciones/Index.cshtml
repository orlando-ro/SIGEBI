@model IEnumerable<SIGEBI.AppWeb.Models.DTOs.Notificaciones.NotificacionResponseDTO>
@{
    ViewData["Title"] = "Mis Notificaciones";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h1 class="fw-bold"><i class="bi bi-bell-fill text-warning"></i> Centro de Notificaciones</h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm border-start border-success border-5">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm border-start border-danger border-5">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row g-3">
            @foreach (var aviso in Model)
            {
                string colorBadge = "bg-primary";
                string icono = "bi-info-circle";

                if (!string.IsNullOrEmpty(aviso.Tipo))
                {
                    switch (aviso.Tipo.ToLower())
                    {
                        case var t when t.Contains("vencimiento") || t.Contains("alerta"):
                            colorBadge = "bg-danger";
                            icono = "bi-exclamation-octagon";
                            break;
                        case var t when t.Contains("penalización") || t.Contains("penalizacion"):
                            colorBadge = "bg-dark";
                            icono = "bi-shield-exclamation";
                            break;
                        case var t when t.Contains("préstamo") || t.Contains("prestamo") || t.Contains("aprobado"):
                            colorBadge = "bg-success";
                            icono = "bi-journal-check";
                            break;
                        case var t when t.Contains("solicitud"):
                            colorBadge = "bg-info text-dark";
                            icono = "bi-bookmark-plus";
                            break;
                    }
                }

                <div class="col-12">
                    <div class="card shadow-sm border-0 border-start border-4 rounded-3 transition-hover" style="background-color: var(--bg-card, #ffffff); border-left-color: var(--bs-primary) !important;">
                        <div class="card-body d-flex flex-column flex-md-row align-items-md-center justify-content-between p-4">

                            <div class="d-flex align-items-center mb-3 mb-md-0">
                                <div class="icon-circle text-white @colorBadge me-4 shadow-sm d-flex align-items-center justify-content-center flex-shrink-0" style="width: 55px; height: 55px; border-radius: 50%; font-size: 1.5rem;">
                                    <i class="bi @icono"></i>
                                </div>
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge @colorBadge shadow-sm">@aviso.Tipo</span>
                                        <small class="text-muted"><i class="bi bi-clock me-1"></i> @aviso.FechaEnvio.ToString("dd MMM yyyy, hh:mm tt")</small>
                                    </div>
                                    <p class="mb-0 fw-semibold fs-5 opacity-85">@aviso.Mensaje</p>
                                </div>
                            </div>

                            <div class="text-md-end ms-md-4 mt-3 mt-md-0">
                                <form asp-action="MarcarComoLeida" method="post">
                                    <input type="hidden" name="id" value="@aviso.Id" />
                                    <button type="submit" class="btn btn-outline-secondary rounded-pill fw-bold shadow-sm px-4">
                                        <i class="bi bi-check2-all me-1"></i> Entendido
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row justify-content-center mt-5">
            <div class="col-md-8">
                <div class="card shadow-lg border-0 border-top border-warning border-5 rounded-4 text-center p-5" style="background-color: var(--bg-card, #ffffff);">
                    <div class="display-1 text-warning mb-4">
                        <i class="bi bi-bell-slash-fill"></i>
                    </div>
                    <h2 class="fw-bold mb-3">¡Bandeja Limpia! ✨</h2>
                    <p class="lead text-muted mb-0 opacity-75">Estás al día. No tienes notificaciones nuevas ni alertas pendientes de lectura por el momento.</p>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .transition-hover:hover {
            transform: translateX(5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }
</style>