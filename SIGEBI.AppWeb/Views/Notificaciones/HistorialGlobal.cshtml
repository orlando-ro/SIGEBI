@model SIGEBI.AppWeb.Models.Notificaciones.HistorialNotificacionesViewModel
@{
    ViewData["Title"] = "Historial de Notificaciones";
    var rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    bool esAdministrador = rolUsuario == "Administrador";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h1 class="fw-bold"><i class="bi bi-envelope-paper-fill text-info"></i> Log de Notificaciones</h1>

        @if (esAdministrador)
        {
            <form asp-action="DispararRecordatorios" method="post" class="d-inline" onsubmit="return confirm('¿Desea forzar el envío de recordatorios automáticos de vencimiento ahora mismo?');">
                <input type="hidden" name="diasAntelacion" value="3" />
                <button type="submit" class="btn btn-info text-white rounded-pill px-4 shadow-sm fw-bold">
                    <i class="bi bi-send-fill me-2"></i> Forzar Recordatorios (3 días)
                </button>
            </form>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm border-start border-success border-5">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <!-- CU-NOT-05: PANEL DE FILTROS -->
    <div class="card shadow-sm border-0 mb-4" style="background-color: var(--bg-card, #ffffff);">
        <div class="card-body p-4">
            <form asp-action="HistorialGlobal" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted mb-1">Tipo de Evento</label>
                        <select asp-for="FiltroTipoEvento" class="form-select bg-transparent text-inherit border-secondary opacity-75 custom-select-options">
                            <option value="">-- Todos los Eventos --</option>
                            <option value="RecordatorioPrestamo">Recordatorio de Préstamo</option>
                            <option value="AlertaRetraso">Alerta de Retraso</option>
                            <option value="AvisoPenalizacion">Aviso de Penalización</option>
                            <option value="ConfirmacionDevolucion">Confirmación de Devolución</option>
                            <option value="PrestamoFormalizado">Préstamo Formalizado</option>
                            <option value="penalizacionResuelta">Penalización Resuelta</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted mb-1">Desde (Fecha)</label>
                        <input asp-for="FechaInicio" type="date" class="form-control bg-transparent text-inherit border-secondary opacity-75" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted mb-1">Hasta (Fecha)</label>
                        <input asp-for="FechaFin" type="date" class="form-control bg-transparent text-inherit border-secondary opacity-75" />
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100 fw-bold rounded-pill shadow-sm"><i class="bi bi-funnel-fill"></i> Filtrar</button>
                        <a asp-action="HistorialGlobal" class="btn btn-outline-secondary rounded-pill shadow-sm" title="Limpiar Filtros"><i class="bi bi-arrow-counterclockwise"></i></a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- TABLA DE RESULTADOS -->
    <div class="card shadow-sm border-0" style="background-color: var(--bg-card, #ffffff);">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-custom table-striped mb-0 align-middle">
                    <thead class="py-3 bg-info text-white">
                        <tr>
                            <th class="py-3 px-4">ID</th>
                            <th class="py-3">Fecha y Hora</th>
                            <th class="py-3">Categoría de Evento</th>
                            <th class="py-3 w-50">Mensaje Enviado</th>
                            <th class="py-3 text-center">Estado del Usuario</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Notificaciones != null && Model.Notificaciones.Any())
                        {
                            foreach (var item in Model.Notificaciones)
                            {
                                <tr>
                                    <td class="fw-bold px-4">@item.Id</td>
                                    <td>@item.FechaEnvio.ToString("dd/MMM/yyyy HH:mm")</td>
                                    <td><span class="badge @item.ColorBadge shadow-sm">@item.Tipo</span></td>
                                    <td class="small opacity-75">@item.Mensaje</td>
                                    <td class="text-center">
                                        @if (item.Leida)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success"><i class="bi bi-check-all"></i> Leída</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary"><i class="bi bi-envelope"></i> Pendiente</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted opacity-50">
                                    <i class="bi bi-mailbox fs-1 d-block mb-2"></i>
                                    No se encontraron notificaciones con los filtros aplicados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .text-inherit {
        color: inherit !important;
    }

    /* Fondo sólido para los dropdowns en modo oscuro/claro para evitar fondo transparente ilegible */
    .custom-select-options option {
        background-color: #2b3035;
        color: #f8f9fa;
    }

    html[data-theme='light'] .custom-select-options option {
        background-color: #ffffff;
        color: #212529;
    }
</style>