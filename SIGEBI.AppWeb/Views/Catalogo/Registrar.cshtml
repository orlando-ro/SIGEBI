@model SIGEBI.AppWeb.Models.Catalogo.RegistrarLibroViewModel
@{
    ViewData["Title"] = "Registrar Recurso";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 border-top border-primary border-4 rounded-4" style="background-color: var(--bg-card, #ffffff);">
                <div class="card-header bg-transparent text-center py-4 border-0">
                    <h3 class="fw-bold text-primary mb-1"><i class="bi bi-book me-2"></i> Nuevo Recurso Bibliográfico</h3>
                    <p class="text-muted small mb-0">Ingresa los metadatos y la cantidad de ejemplares físicos disponibles.</p>
                </div>
                <div class="card-body p-4 p-md-5">

                    <form asp-action="Registrar" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="ISBN" class="form-label fw-bold text-muted small">Código ISBN</label>
                                <input asp-for="ISBN" class="form-control bg-transparent text-inherit border-secondary opacity-75" required placeholder="Ej: 978-3-16-148410-0" />
                                <span asp-validation-for="ISBN" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Titulo" class="form-label fw-bold text-muted small">Título del Recurso</label>
                                <input asp-for="Titulo" class="form-control bg-transparent text-inherit border-secondary opacity-75" required placeholder="Ej: Clean Architecture" />
                                <span asp-validation-for="Titulo" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="NombreAutor" class="form-label fw-bold text-muted small">Autor(es)</label>
                                <input asp-for="NombreAutor" class="form-control bg-transparent text-inherit border-secondary opacity-75" required placeholder="Ej: Robert C. Martin" />
                                <span asp-validation-for="NombreAutor" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AnioPublicacion" class="form-label fw-bold text-muted small">Año de Publicación</label>
                                <input asp-for="AnioPublicacion" class="form-control bg-transparent text-inherit border-secondary opacity-75" type="number" required placeholder="Ej: 2017" />
                                <span asp-validation-for="AnioPublicacion" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="IdCategoria" class="form-label fw-bold text-muted small">Categoría</label>
                                <select asp-for="IdCategoria" class="form-select bg-transparent text-inherit border-secondary opacity-75" asp-items="ViewBag.Categorias" required>
                                    <option value="">-- Seleccione una --</option>
                                </select>
                                <span asp-validation-for="IdCategoria" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CopiasTotales" class="form-label fw-bold text-muted small">Nº de Ejemplares Físicos</label>
                                <input asp-for="CopiasTotales" class="form-control bg-transparent text-inherit border-secondary opacity-75" type="number" min="1" required placeholder="Cantidad a registrar..." />
                                <span asp-validation-for="CopiasTotales" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Imagen" class="form-label fw-bold text-muted small"><i class="bi bi-image"></i> Portada del Libro (Opcional)</label>
                                <input asp-for="Imagen" type="file" class="form-control bg-transparent text-inherit border-secondary opacity-75" accept="image/*" />
                                <div class="form-text opacity-50">Sube una imagen representativa para el catálogo.</div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-5">
                            <a asp-action="Index" class="btn btn-link text-secondary text-decoration-none fw-semibold"><i class="bi bi-arrow-left"></i> Cancelar</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
                                <i class="bi bi-save me-2"></i> Registrar Catálogo
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>