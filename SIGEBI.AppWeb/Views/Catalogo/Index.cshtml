@model IEnumerable<SIGEBI.AppWeb.Models.Catalogo.CatalogoItemViewModel>
@{
    ViewData["Title"] = "Catálogo Bibliográfico";
    var rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    bool esPersonalBibliotecario = rolUsuario == "PersonalBibliotecario";
    bool esAdministrador = rolUsuario == "Administrador";
    bool esAuditor = rolUsuario == "Auditor";
    bool puedeGestionar = esPersonalBibliotecario || esAdministrador;
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h1 class="fw-bold text-inherit"><i class="bi bi-collection-fill text-primary"></i> Catálogo Bibliográfico</h1>

        @if (puedeGestionar)
        {
            <div class="d-flex gap-2">
                <a asp-controller="Categorias" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">
                    <i class="bi bi-tags"></i> Categorías
                </a>
                <a asp-action="Registrar" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
                    <i class="bi bi-plus-lg"></i> Nuevo Recurso
                </a>
            </div>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm border-start border-success border-5">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm border-start border-danger border-5">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    <!-- FILTROS DE BÚSQUEDA -->
    <div class="card shadow-sm border-0 mb-5" style="background-color: var(--bg-card, #ffffff);">
        <div class="card-body p-4">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <div class="col-md-3">
                        <input type="text" name="titulo" class="form-control bg-transparent text-inherit border-secondary" placeholder="Buscar por Título..." />
                    </div>
                    <div class="col-md-3">
                        <input type="text" name="autor" class="form-control bg-transparent text-inherit border-secondary" placeholder="Buscar por Autor..." />
                    </div>
                    <div class="col-md-3">
                        <select name="idCategoria" class="form-select bg-transparent text-inherit border-secondary custom-select-options" asp-items="ViewBag.Categorias">
                            <option value="">Todas las Categorías</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100 fw-bold rounded-pill shadow-sm"><i class="bi bi-search"></i> Buscar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill shadow-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
                    </div>
                </div>
                <div class="mt-3 form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="soloDisponibles" id="soloDisponibles" value="true">
                    <label class="form-check-label text-inherit small fw-semibold" for="soloDisponibles">Mostrar solo recursos disponibles</label>
                </div>
            </form>
        </div>
    </div>

    <!-- GRID DE RESULTADOS -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var libro in Model)
            {
                <div class="col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm border-0 transition-hover d-flex flex-column" style="background-color: var(--bg-card, #ffffff);">
                        <div class="bg-light text-center rounded-top overflow-hidden position-relative" style="height: 250px; display: flex; align-items: center; justify-content: center;">
                            @if (!string.IsNullOrEmpty(libro.UrlImagen))
                            {
                                <img src="@libro.UrlImagen" alt="@libro.Titulo" class="img-fluid h-100 object-fit-cover w-100" />
                            }
                            else
                            {
                                <i class="bi bi-book text-muted opacity-25" style="font-size: 6rem;"></i>
                            }

                            <!-- Etiqueta de estado flotante sobre la imagen -->
                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge @(libro.CopiasDisponibles > 0 ? "bg-success" : "bg-danger") shadow-sm">
                                    @(libro.CopiasDisponibles > 0 ? $"{libro.CopiasDisponibles} Disponibles" : "Agotado")
                                </span>
                            </div>
                        </div>

                        <div class="card-body d-flex flex-column text-inherit flex-grow-1">
                            <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary mb-2 align-self-start" style="font-size: 0.7rem;">
                                @libro.NombreCategoria
                            </span>
                            <h5 class="fw-bold mb-1 text-truncate text-inherit" title="@libro.Titulo">@libro.Titulo</h5>
                            <p class="small text-muted mb-3"><i class="bi bi-pen me-1"></i> @libro.NombreAutor</p>

                            <!-- Sección ISBN con botón de copiado (Función en site.js) -->
                            <div class="mt-auto bg-dark bg-opacity-10 rounded p-2 d-flex justify-content-between align-items-center border">
                                <span class="small font-monospace fw-semibold text-inherit opacity-75">
                                    <i class="bi bi-upc-scan me-1"></i> @libro.ISBN
                                </span>
                                <button type="button" onclick="copiarIsbn('@libro.ISBN')" class="btn btn-sm btn-link text-inherit p-0 opacity-50 hover-opacity-100" title="Copiar ISBN">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                        </div>

                        <!-- PANEL DE ACCIONES INFERIOR -->
                        <div class="card-footer bg-transparent border-top-0 pt-0 pb-3 d-flex flex-column gap-2">

                            <!-- Acciones Universales -->
                            <div class="d-flex gap-2">
                                <a asp-action="Detalles" asp-route-isbn="@libro.ISBN" class="btn btn-sm btn-outline-secondary fw-semibold w-100">
                                    <i class="bi bi-eye"></i> Detalles
                                </a>

                                <!-- Botón Solicitar (Función en site.js) -->
                                @if (!puedeGestionar && !esAuditor)
                                {
                                    if (libro.CopiasDisponibles > 0)
                                    {
                                        <button type="button" onclick="agregarAlCarrito('@libro.ISBN', '@Html.Raw(libro.Titulo.Replace("'", "\\'"))')" class="btn btn-sm btn-primary fw-bold w-100 shadow-sm">
                                            <i class="bi bi-journal-plus"></i> Solicitar
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-secondary fw-bold w-100 shadow-sm" disabled title="No hay ejemplares disponibles">
                                            Agotado
                                        </button>
                                    }
                                }
                            </div>

                            <!-- Acciones de Gestión (Bibliotecario/Admin) -->
                            @if (puedeGestionar)
                            {
                                <div class="d-flex gap-2 mt-1">
                                    <a asp-action="Actualizar" asp-route-isbn="@libro.ISBN" class="btn btn-sm btn-outline-primary w-100">Editar</a>

                                    @if (esAdministrador)
                                    {
                                        <form asp-action="Eliminar" method="post" class="w-100" onsubmit="return confirm('¿Está seguro que desea dar de baja el recurso @Html.Raw(libro.Titulo.Replace("'", "\\'"))?');">
                                            <input type="hidden" name="isbn" value="@libro.ISBN" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">Baja</button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="display-1 text-muted opacity-25 mb-3"><i class="bi bi-journal-x"></i></div>
            <h3 class="fw-bold opacity-75 text-inherit">No se encontraron resultados</h3>
            <p class="text-muted">Intenta ajustando los filtros de búsqueda.</p>
        </div>
    }
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .transition-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    .hover-opacity-100:hover {
        opacity: 1 !important;
        color: var(--bs-primary) !important;
    }

    .text-inherit {
        color: inherit !important;
    }

    .form-control.text-inherit::placeholder {
        color: inherit !important;
        opacity: 0.6;
    }

    .custom-select-options option {
        background-color: #2b3035;
        color: #f8f9fa;
    }

    html[data-theme='light'] .custom-select-options option {
        background-color: #ffffff;
        color: #212529;
    }
</style>