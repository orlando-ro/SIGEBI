@model IEnumerable<SIGEBI.AppWeb.Models.Catalogo.CatalogoItemViewModel>
@{
    ViewData["Title"] = "Catálogo Bibliográfico";
    var rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    bool esPersonalBibliotecario = rolUsuario == "PersonalBibliotecario";
    bool esAdministrador = rolUsuario == "Administrador";
    bool puedeGestionar = esPersonalBibliotecario || esAdministrador;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h1 class="fw-bold"><i class="bi bi-collection-fill text-primary"></i> Catálogo Bibliográfico</h1>

        @if (puedeGestionar)
        {
            <div class="d-flex gap-2">
                <a asp-controller="Categorias" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">
                    <i class="bi bi-tags"></i> Categorías
                </a>
                <a asp-action="Registrar" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
                    <i class="bi bi-plus-lg"></i> Nuevo Recurso
                </a>
            </div>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm border-start border-success border-5">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm border-start border-danger border-5">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    <!-- FILTROS DE BÚSQUEDA -->
    <div class="card shadow-sm border-0 mb-5" style="background-color: var(--bg-card, #ffffff);">
        <div class="card-body p-4">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <div class="col-md-3">
                        <input type="text" name="titulo" class="form-control bg-transparent text-inherit border-secondary opacity-75" placeholder="Buscar por Título..." />
                    </div>
                    <div class="col-md-3">
                        <input type="text" name="autor" class="form-control bg-transparent text-inherit border-secondary opacity-75" placeholder="Buscar por Autor..." />
                    </div>
                    <div class="col-md-3">
                        <select name="idCategoria" class="form-select bg-transparent text-inherit border-secondary opacity-75 custom-select-options" asp-items="ViewBag.Categorias">
                            <option value="">Todas las Categorías</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100 fw-bold rounded-pill shadow-sm"><i class="bi bi-search"></i> Buscar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill shadow-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
                    </div>
                </div>
                <div class="mt-3 form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="soloDisponibles" id="soloDisponibles" value="true">
                    <label class="form-check-label opacity-75 small fw-semibold" for="soloDisponibles">Mostrar solo recursos disponibles</label>
                </div>
            </form>
        </div>
    </div>

    <!-- GRID DE RESULTADOS -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var libro in Model)
            {
                <div class="col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm border-0 transition-hover" style="background-color: var(--bg-card, #ffffff);">
                        <div class="bg-light text-center rounded-top overflow-hidden" style="height: 250px; display: flex; align-items: center; justify-content: center;">
                            @if (!string.IsNullOrEmpty(libro.UrlImagen))
                            {
                                <img src="@libro.UrlImagen" alt="@libro.Titulo" class="img-fluid h-100 object-fit-cover w-100" />
                            }
                            else
                            {
                                <i class="bi bi-book text-muted opacity-25" style="font-size: 6rem;"></i>
                            }
                        </div>

                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-secondary mb-2 align-self-start">@libro.NombreCategoria</span>
                            <h5 class="fw-bold mb-1 text-truncate" title="@libro.Titulo">@libro.Titulo</h5>
                            <p class="small text-muted mb-2"><i class="bi bi-pen"></i> @libro.NombreAutor</p>
                            <p class="small opacity-75 mb-3"><i class="bi bi-upc-scan"></i> ISBN: @libro.ISBN</p>

                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <span class="badge @(libro.CopiasDisponibles > 0 ? "bg-success" : "bg-danger") px-3 py-2">
                                    @(libro.CopiasDisponibles > 0 ? $"{libro.CopiasDisponibles} Disponibles" : "Agotado")
                                </span>
                            </div>
                        </div>

                        @if (puedeGestionar)
                        {
                            <div class="card-footer bg-transparent border-top-0 pt-0 d-flex gap-2">
                                <a asp-action="Actualizar" asp-route-isbn="@libro.ISBN" class="btn btn-sm btn-outline-primary flex-grow-1">Editar</a>

                                @if (esAdministrador)
                                {
                                    <form asp-action="Eliminar" method="post" class="flex-grow-1" onsubmit="return confirm('¿Está seguro que desea dar de baja el recurso @libro.Titulo?');">
                                        <input type="hidden" name="isbn" value="@libro.ISBN" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">Baja</button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="display-1 text-muted opacity-25 mb-3"><i class="bi bi-journal-x"></i></div>
            <h3 class="fw-bold opacity-75">No se encontraron resultados</h3>
            <p class="text-muted">Intenta ajustando los filtros de búsqueda.</p>
        </div>
    }
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .transition-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    .text-inherit {
        color: inherit !important;
    }

        .text-inherit::placeholder {
            color: inherit !important;
            opacity: 0.6;
        }

    /* CORRECCIÓN: Fondo sólido para las opciones del selector en modo nocturno/azul */
    .custom-select-options option {
        background-color: #2b3035; /* Color base para modo oscuro */
        color: #f8f9fa;
    }
    /* CORRECCIÓN: Fondo sólido claro si el usuario elige el tema claro */
    html[data-theme='light'] .custom-select-options option {
        background-color: #ffffff;
        color: #212529;
    }
</style>