@model SIGEBI.AppWeb.Models.Catalogo.ActualizarLibroViewModel
@{
    ViewData["Title"] = "Editar Recurso";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 border-top border-warning border-4 rounded-4" style="background-color: var(--bg-card, #ffffff);">
                <div class="card-header bg-transparent text-center py-4 border-0">
                    <h3 class="fw-bold text-warning mb-1"><i class="bi bi-pencil-square me-2"></i> Actualizar Recurso</h3>
                    <p class="text-muted small mb-0">ISBN Bloqueado: @Model.ISBN</p>
                </div>
                <div class="card-body p-4 p-md-5">

                    <form asp-action="Actualizar" method="post">
                        <!-- Pasamos el ISBN oculto desde el modelo -->
                        <input type="hidden" asp-for="ISBN" />

                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-12">
                                <label asp-for="Titulo" class="form-label fw-bold text-muted small">Título del Recurso</label>
                                <input asp-for="Titulo" class="form-control bg-transparent text-inherit border-secondary opacity-75" required />
                                <span asp-validation-for="Titulo" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="NombreAutor" class="form-label fw-bold text-muted small">Autor(es)</label>
                                <input asp-for="NombreAutor" class="form-control bg-transparent text-inherit border-secondary opacity-75" required />
                                <span asp-validation-for="NombreAutor" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AnioPublicacion" class="form-label fw-bold text-muted small">Año de Publicación</label>
                                <input asp-for="AnioPublicacion" class="form-control bg-transparent text-inherit border-secondary opacity-75" type="number" required />
                                <span asp-validation-for="AnioPublicacion" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="IdCategoria" class="form-label fw-bold text-muted small">Categoría Asignada</label>
                                <select asp-for="IdCategoria" class="form-select bg-transparent text-inherit border-secondary opacity-75" asp-items="ViewBag.Categorias" required>
                                    <option value="">-- Seleccione una --</option>
                                </select>
                                <span asp-validation-for="IdCategoria" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-5">
                            <a asp-action="Index" class="btn btn-link text-secondary text-decoration-none fw-semibold"><i class="bi bi-arrow-left"></i> Cancelar</a>
                            <button type="submit" class="btn btn-warning text-dark rounded-pill px-5 fw-bold shadow-sm">
                                <i class="bi bi-check-circle me-2"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>