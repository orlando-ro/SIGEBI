@model SIGEBI.AppWeb.Models.Categorias.CategoriaFormViewModel
@{
    ViewData["Title"] = "Registrar Categoría";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 border-top border-secondary border-4 rounded-4" style="background-color: var(--bg-card, #ffffff);">
                <div class="card-header bg-transparent text-center py-4 border-0">
                    <h3 class="fw-bold text-secondary mb-1"><i class="bi bi-tag me-2"></i> Nueva Categoría</h3>
                    <p class="text-muted small mb-0">Registra una nueva clasificación para organizar los recursos.</p>
                </div>
                <div class="card-body p-4 p-md-5">

                    <form asp-action="Registrar" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Nombre" class="form-label fw-bold text-muted small"><i class="bi bi-fonts me-1"></i> Nombre de la Categoría</label>
                            <input asp-for="Nombre" class="form-control bg-transparent text-inherit" required placeholder="Ej: Programación, Ficción..." autocomplete="off" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="mb-5">
                            <label asp-for="Descripcion" class="form-label fw-bold text-muted small"><i class="bi bi-card-text me-1"></i> Descripción (Opcional)</label>
                            <textarea asp-for="Descripcion" class="form-control bg-transparent text-inherit" rows="3" placeholder="Breve descripción..."></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-link text-secondary text-decoration-none fw-semibold"><i class="bi bi-arrow-left"></i> Cancelar</a>
                            <button type="submit" class="btn btn-secondary rounded-pill px-4 fw-bold shadow-sm">
                                <i class="bi bi-save me-2"></i> Guardar Categoría
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>