@model SIGEBI.AppWeb.Models.Categorias.CategoriaFormViewModel
@{
    ViewData["Title"] = "Actualizar Categoría";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 border-top border-primary border-4 rounded-4" style="background-color: var(--bg-card, #ffffff);">
                <div class="card-header bg-transparent text-center py-4 border-0">
                    <h3 class="fw-bold text-primary mb-1"><i class="bi bi-pencil-square me-2"></i> Editar Categoría</h3>
                    <p class="text-muted small mb-0">Modificando la categoría #@Model.IdCategoria</p>
                </div>
                <div class="card-body p-4 p-md-5">

                    <form asp-action="Actualizar" method="post">
                        <!-- El ID ahora viene del ViewModel -->
                        <input type="hidden" asp-for="IdCategoria" />

                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Nombre" class="form-label fw-bold text-muted small"><i class="bi bi-fonts me-1"></i> Nombre de la Categoría</label>
                            <input asp-for="Nombre" class="form-control bg-transparent text-inherit" required />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="mb-5">
                            <label asp-for="Descripcion" class="form-label fw-bold text-muted small"><i class="bi bi-card-text me-1"></i> Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control bg-transparent text-inherit" rows="3"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-link text-secondary text-decoration-none fw-semibold"><i class="bi bi-arrow-left"></i> Cancelar</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                                <i class="bi bi-check-circle me-2"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>