@{
    ViewData["Title"] = "Centro de Reportes";
    var rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    bool esAdminOAuditor = rolUsuario == "Administrador" || rolUsuario == "Auditor";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h1 class="fw-bold"><i class="bi bi-file-earmark-pdf-fill text-danger"></i> Centro de Reportes y Estadísticas</h1>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-start border-danger border-5 shadow-sm">
            <i class="bi bi-x-circle-fill me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    <p class="mb-4 opacity-75">Seleccione el tipo de reporte que desea generar. Los documentos se descargarán automáticamente en formato PDF.</p>

    <div class="row g-4">

        <!-- Tarjeta de Inventario (Accesible para Bibliotecarios, Admin y Auditores) -->
        <div class="col-md-6">
            <div class="card h-100 shadow-sm transition-hover border-top border-success border-4" style="background-color: var(--bg-card, #ffffff);">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-success mb-3"><i class="bi bi-boxes"></i> Inventario de Recursos</h5>
                    <p class="small mb-4 opacity-75">Genera un reporte del estado actual de todos los libros, detallando disponibilidad, préstamos activos y ejemplares dañados.</p>

                    <a asp-action="DescargarInventario" class="btn btn-success w-100 fw-bold rounded-pill shadow-sm">
                        <i class="bi bi-download me-2"></i> Descargar PDF
                    </a>
                </div>
            </div>
        </div>

        @if (esAdminOAuditor)
        {
            <!-- Tarjeta de Préstamos -->
            <div class="col-md-6">
                <div class="card h-100 shadow-sm transition-hover border-top border-primary border-4" style="background-color: var(--bg-card, #ffffff);">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-primary mb-3"><i class="bi bi-journal-bookmark"></i> Estadísticas de Préstamos</h5>
                        <p class="small mb-4 opacity-75">Evalúa el volumen de préstamos, índice de puntualidad y cantidad de recursos devueltos a tiempo o con retraso.</p>

                        <form asp-action="DescargarPrestamos" method="get">
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="small fw-semibold opacity-75">Desde</label>
                                    <input type="date" name="fechaInicio" class="form-control form-control-sm bg-transparent text-inherit border-secondary opacity-75" value="@ViewBag.FechaInicio" required />
                                </div>
                                <div class="col-6">
                                    <label class="small fw-semibold opacity-75">Hasta</label>
                                    <input type="date" name="fechaFin" class="form-control form-control-sm bg-transparent text-inherit border-secondary opacity-75" value="@ViewBag.FechaFin" required />
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 fw-bold rounded-pill shadow-sm">
                                <i class="bi bi-download me-2"></i> Descargar PDF
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Tarjeta de Catálogo -->
            <div class="col-md-6">
                <div class="card h-100 shadow-sm transition-hover border-top border-info border-4" style="background-color: var(--bg-card, #ffffff);">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-info mb-3"><i class="bi bi-bar-chart-fill"></i> Uso del Catálogo</h5>
                        <p class="small mb-4 opacity-75">Identifica los libros más populares y analiza la demanda por categoría para tomar decisiones de adquisición.</p>

                        <form asp-action="DescargarCatalogo" method="get">
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="small fw-semibold opacity-75">Desde</label>
                                    <input type="date" name="fechaInicio" class="form-control form-control-sm bg-transparent text-inherit border-secondary opacity-75" value="@ViewBag.FechaInicio" required />
                                </div>
                                <div class="col-6">
                                    <label class="small fw-semibold opacity-75">Hasta</label>
                                    <input type="date" name="fechaFin" class="form-control form-control-sm bg-transparent text-inherit border-secondary opacity-75" value="@ViewBag.FechaFin" required />
                                </div>
                            </div>
                            <button type="submit" class="btn btn-info text-white w-100 fw-bold rounded-pill shadow-sm">
                                <i class="bi bi-download me-2"></i> Descargar PDF
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Tarjeta de Penalizaciones -->
            <div class="col-md-6">
                <div class="card h-100 shadow-sm transition-hover border-top border-warning border-4" style="background-color: var(--bg-card, #ffffff);">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-warning mb-3"><i class="bi bi-exclamation-triangle-fill"></i> Reporte de Penalizaciones</h5>
                        <p class="small mb-4 opacity-75">Consolida los ingresos por multas y visualiza el historial de resoluciones de los usuarios morosos.</p>

                        <form asp-action="DescargarPenalizaciones" method="get">
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="small fw-semibold opacity-75">Desde</label>
                                    <input type="date" name="fechaInicio" class="form-control form-control-sm bg-transparent text-inherit border-secondary opacity-75" value="@ViewBag.FechaInicio" required />
                                </div>
                                <div class="col-6">
                                    <label class="small fw-semibold opacity-75">Hasta</label>
                                    <input type="date" name="fechaFin" class="form-control form-control-sm bg-transparent text-inherit border-secondary opacity-75" value="@ViewBag.FechaFin" required />
                                </div>
                            </div>
                            <button type="submit" class="btn btn-warning text-dark w-100 fw-bold rounded-pill shadow-sm">
                                <i class="bi bi-download me-2"></i> Descargar PDF
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Tarjeta de Auditoría -->
            <div class="col-12 mt-4">
                <div class="card shadow-sm transition-hover border-start border-secondary border-5" style="background-color: var(--bg-card, #ffffff);">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3"><i class="bi bi-shield-lock-fill text-secondary me-2"></i> Log de Auditoría del Sistema</h5>
                        <p class="small mb-4 opacity-75">Extrae el registro inmutable de transacciones. Puedes filtrar por el ID del usuario o el nombre de la entidad (ej: "Prestamo", "Penalizacion").</p>

                        <form asp-action="DescargarAuditoria" method="get">
                            <div class="row g-3 align-items-end">
                                <div class="col-md-4">
                                    <label class="small fw-semibold mb-1 opacity-75">ID de Usuario Responsable (Opcional)</label>
                                    <div class="input-group shadow-sm">
                                        <span class="input-group-text bg-transparent border-secondary opacity-50"><i class="bi bi-person"></i></span>
                                        <input type="number" name="idResponsable" class="form-control bg-transparent border-secondary text-inherit" placeholder="Ej: 15" />
                                    </div>
                                </div>
                                <div class="col-md-5">
                                    <label class="small fw-semibold mb-1 opacity-75">Entidad Afectada (Opcional)</label>
                                    <div class="input-group shadow-sm">
                                        <span class="input-group-text bg-transparent border-secondary opacity-50"><i class="bi bi-box"></i></span>
                                        <input type="text" name="entidadAfectada" class="form-control bg-transparent border-secondary text-inherit" placeholder="Ej: Devolucion" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <button type="submit" class="btn btn-secondary w-100 fw-bold rounded-pill shadow-sm">
                                        <i class="bi bi-file-earmark-break me-2"></i> Extraer Logs
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .transition-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }

    /* Clases de apoyo para mantener el color heredado en cualquier tema */
    .text-inherit {
        color: inherit !important;
    }

        .text-inherit::placeholder {
            color: inherit !important;
            opacity: 0.6;
        }

    /* Pequeño ajuste para que los iconos de los inputs de fecha no se pierdan en modo oscuro */
    input[type="date"]::-webkit-calendar-picker-indicator {
        filter: invert(0.5);
    }
</style>