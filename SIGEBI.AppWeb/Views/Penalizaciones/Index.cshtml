@{
    ViewData["Title"] = "Gestión de Penalizaciones";
    var rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    bool esEstudianteODocente = rolUsuario == "Estudiante" || rolUsuario == "Docente";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h1 class="fw-bold"><i class="bi bi-exclamation-triangle-fill text-danger"></i> Módulo de Penalizaciones</h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm border-start border-danger border-5">
            <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    @if (esEstudianteODocente)
    {
        <div class="row justify-content-center my-4">
            <div class="col-md-9">
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden" style="background-color: var(--bg-card, #1e2532);">
                    <div class="card-body p-4 p-md-5 text-center">
                        <div class="display-4 text-danger mb-3">
                            <i class="bi bi-cash-coin"></i>
                        </div>
                        <!-- TEXTO PERSONALIZADO PARA ESTUDIANTES Y DOCENTES -->
                        <h4 class="fw-bold mb-3 text-white">Mis Penalizaciones</h4>
                        <p class="text-muted mb-4">Ingrese su matrícula para que pueda ver sus penalizaciones que están pendientes por retrasos o daños.</p>

                        <form asp-action="ConsultarPorUsuario" method="get">
                            <div class="input-group input-group-lg mb-3 shadow-sm rounded-pill overflow-hidden border border-secondary">
                                <span class="input-group-text bg-transparent border-0"><i class="bi bi-search text-muted ps-2"></i></span>
                                <input type="text" class="form-control bg-transparent text-white border-0" name="identificador" required placeholder="Ej: 2024-1234" autocomplete="off" />
                                <button class="btn btn-danger px-5 fw-bold" type="submit">Consultar Activas</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="card h-100 shadow-sm border-0 border-start border-danger border-4 transition-hover">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="fw-bold text-danger"><i class="bi bi-search me-2"></i> Consultar Penalizaciones</h5>
                            <p class="small text-muted mb-4">Verifica el historial y estado actual de las multas pendientes asignadas a un usuario específico.</p>
                        </div>
                        <form asp-action="ConsultarPorUsuario" method="get">
                            <div class="input-group shadow-sm">
                                <input type="text" class="form-control" name="identificador" required placeholder="Ej: Matrícula o Empleado" />
                                <button class="btn btn-danger px-4 fw-bold" type="submit">Buscar</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card h-100 shadow-sm border-0 border-start border-success border-4 transition-hover">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="fw-bold text-success"><i class="bi bi-shield-check me-2"></i> Resolver Penalización</h5>
                            <p class="small text-muted mb-4">Registra el pago de una multa y habilita nuevamente al usuario dentro del sistema para realizar préstamos.</p>
                        </div>
                        <div class="text-end mt-auto">
                            <a asp-action="Resolver" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm w-100">Registrar Resolución</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .transition-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }
</style>