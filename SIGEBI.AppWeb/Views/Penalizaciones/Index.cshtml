@model IEnumerable<SIGEBI.Application.DTOs.PenalizacionResponseDTO>
@{
    ViewData["Title"] = "Gestión de Penalizaciones";
    var rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    bool esUsuarioRegular = rolUsuario == "Estudiante" || rolUsuario == "Docente";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h1 class="fw-bold"><i class="bi bi-exclamation-triangle-fill text-danger"></i> Módulo de Penalizaciones</h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm border-start border-success border-5">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm border-start border-danger border-5">
            <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    <!-- VISTA EXCLUSIVA PARA ESTUDIANTES Y DOCENTES -->
    @if (esUsuarioRegular)
    {
        if (Model != null && Model.Any())
        {
            <!-- Si tiene penalizaciones, mostramos la tabla directamente -->
            <div class="card shadow-sm border-0 border-top border-danger border-4 mb-4">
                <div class="card-body p-4">
                    <h4 class="fw-bold text-danger mb-3"><i class="bi bi-cash-coin me-2"></i> Mis Penalizaciones</h4>
                    <p class="text-muted mb-4 opacity-75">Estas son las multas activas registradas en tu cuenta por daños o devoluciones tardías.</p>

                    <div class="table-responsive">
                        <table class="table table-hover table-custom table-striped mb-0 align-middle text-center">
                            <thead class="py-3 bg-danger text-white">
                                <tr>
                                    <th class="py-3 px-3">ID Multa</th>
                                    <th class="py-3">Préstamo</th>
                                    <th class="py-3">Monto</th>
                                    <th class="py-3 text-start">Motivo</th>
                                    <th class="py-3">Fecha Emisión</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="fw-bold px-3">#@item.IdPenalizacion</td>
                                        <td><span class="badge bg-secondary">Préstamo #@item.IdPrestamo</span></td>
                                        <td class="fw-bold text-danger">RD$ @item.Monto.ToString("N2")</td>
                                        <td class="text-start small">@item.Motivo</td>
                                        <td>@item.FechaEmision.ToString("dd/MMM/yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Si no tiene penalizaciones, mostramos el mensaje de felicitaciones -->
            <div class="row justify-content-center mt-5">
                <div class="col-md-8">
                    <div class="card shadow-lg border-0 border-top border-success border-5 rounded-4 text-center p-5" style="background-color: var(--bg-card, #ffffff);">
                        <div class="display-1 text-success mb-4">
                            <i class="bi bi-award-fill"></i>
                        </div>
                        <h2 class="fw-bold mb-3">¡Felicidades! 🎉</h2>
                        <p class="lead text-muted mb-4">Tienes un récord impecable.</p>
                        <p class="mb-0 opacity-75">No cuentas con penalizaciones ni multas activas. ¡Sigue así, cuidando los recursos de nuestra biblioteca! 🌟</p>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <!-- VISTA PARA EL PERSONAL BIBLIOTECARIO Y ADMIN -->
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="card h-100 shadow-sm border-0 border-start border-danger border-4 transition-hover">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="fw-bold text-danger"><i class="bi bi-search me-2"></i> Consultar Penalizaciones</h5>
                            <p class="small text-muted mb-4">Verifica el historial y estado actual de las multas pendientes asignadas a un usuario específico.</p>
                        </div>
                        <form asp-action="ConsultarPorUsuario" method="get">
                            <div class="input-group shadow-sm">
                                <input type="text" class="form-control bg-transparent text-inherit" name="identificador" required placeholder="Ej: Matrícula o Empleado" />
                                <button class="btn btn-danger px-4 fw-bold" type="submit">Buscar</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card h-100 shadow-sm border-0 border-start border-success border-4 transition-hover">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="fw-bold text-success"><i class="bi bi-shield-check me-2"></i> Resolver Penalización</h5>
                            <p class="small text-muted mb-4">Registra el pago de una multa y habilita nuevamente al usuario dentro del sistema para realizar préstamos.</p>
                        </div>
                        <div class="text-end mt-auto">
                            <a asp-action="Resolver" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm w-100">Registrar Resolución</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .transition-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }
</style>