@model IEnumerable<SIGEBI.AppWeb.Models.Penalizaciones.PenalizacionItemViewModel>
@{
    ViewData["Title"] = "Penalizaciones Pendientes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <div>
            <h2 class="fw-bold text-danger"><i class="bi bi-receipt"></i> Multas Pendientes</h2>
            @if (ViewBag.Busqueda != null)
            {
                <p class="text-muted mb-0">Usuario: <strong>@ViewBag.Busqueda</strong></p>
            }
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">Nueva Búsqueda</a>
    </div>

    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-success border-start border-success border-5 shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["WarningMessage"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-custom table-striped mb-0 text-center align-middle">
                        <thead class="py-3 bg-danger text-white">
                            <tr>
                                <th class="py-3">ID Multa</th>
                                <th class="py-3">Fecha Emisión</th>
                                <th class="py-3">Motivo</th>
                                <th class="py-3">Préstamo Ref.</th>
                                <th class="py-3">Monto</th>
                                <th class="py-3">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">#@item.IdPenalizacion</td>
                                    <td>@item.FechaEmision.ToString("dd/MMM/yyyy")</td>
                                    <td class="text-start">
                                        <span class="small fw-semibold">@item.Motivo</span>
                                    </td>
                                    <td class="text-muted">@(item.IdPrestamo.HasValue ? $"#{item.IdPrestamo}" : "N/A")</td>
                                    <td class="fw-bold text-danger">RD$ @item.Monto.ToString("N2")</td>
                                    <td>
                                        <a asp-action="Resolver"
                                           asp-route-id="@item.IdPenalizacion"
                                           asp-route-identificador="@item.Identificador"
                                           asp-route-monto="@item.Monto"
                                           asp-route-concepto="@item.Motivo"
                                           class="btn btn-sm btn-success shadow-sm rounded-pill px-3">
                                            <i class="bi bi-cash me-1"></i> Cobrar / Resolver
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>