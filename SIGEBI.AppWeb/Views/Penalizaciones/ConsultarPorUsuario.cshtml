@model IEnumerable<SIGEBI.Application.DTOs.PenalizacionResponseDTO>
@{
    ViewData["Title"] = "Penalizaciones Pendientes";
    var rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    bool esPersonalBibliotecario = rolUsuario == "PersonalBibliotecario";
    bool esAdministrador = rolUsuario == "Administrador";
    bool puedeResolver = esPersonalBibliotecario || esAdministrador;
    bool esUsuarioRegular = ViewBag.EsUsuarioRegular ?? false;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill"></i> Penalizaciones Pendientes</h2>
            @if (!esUsuarioRegular)
            {
                <p class="text-muted mb-0">Resultados activos para: <span class="fw-bold">@ViewBag.Busqueda</span></p>
            }
        </div>

        @if (esUsuarioRegular)
        {
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">Volver al Inicio</a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">Volver Atrás</a>
        }
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-custom table-striped mb-0 align-middle text-center">
                        <thead class="py-3 bg-danger text-white">
                            <tr>
                                <th class="py-3 px-3">ID Multa</th>
                                <th class="py-3">Préstamo</th>
                                <th class="py-3">Monto</th>
                                <th class="py-3 text-start">Motivo</th>
                                <th class="py-3">Fecha Emisión</th>
                                @if (puedeResolver)
                                {
                                    <th class="py-3">Acciones</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold px-3">#@item.IdPenalizacion</td>
                                    <td><span class="badge bg-secondary">Préstamo #@item.IdPrestamo</span></td>
                                    <td class="fw-bold text-danger">RD$ @item.Monto.ToString("N2")</td>
                                    <td class="text-start small">@item.Motivo</td>
                                    <td>@item.FechaEmision.ToString("dd/MMM/yyyy")</td>

                                    @if (puedeResolver)
                                    {
                                        <td>
                                            <a asp-action="Resolver" asp-route-id="@item.IdPenalizacion" class="btn btn-sm btn-success shadow-sm">
                                                <i class="bi bi-shield-check"></i> Resolver
                                            </a>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- PANTALLA VACÍA PERSONALIZADA -->
        @if (esUsuarioRegular)
        {
            <div class="row justify-content-center mt-5">
                <div class="col-md-8">
                    <div class="card shadow-lg border-0 border-top border-success border-5 rounded-4 text-center p-5" style="background-color: var(--bg-card, #ffffff);">
                        <div class="display-1 text-success mb-4">
                            <i class="bi bi-award-fill"></i>
                        </div>
                        <h2 class="fw-bold mb-3">¡Felicidades! 🎉</h2>
                        <p class="lead text-muted mb-4">Tienes un récord impecable.</p>
                        <p class="mb-0 opacity-75">No cuentas con penalizaciones ni multas activas. ¡Sigue así, cuidando los recursos de nuestra biblioteca! 🌟</p>
                    </div>
                </div>
            </div>
        }
    }
</div>