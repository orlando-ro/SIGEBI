@model SIGEBI.Application.DTOs.UsuarioUpdateRequestDTO
@{
    ViewData["Title"] = "Editar Usuario";
    string tipoUsuario = ViewBag.TipoUsuario as string ?? "";
    bool esEstudiante = tipoUsuario.Equals("Estudiante", StringComparison.OrdinalIgnoreCase);
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i> Editar Usuario</h2>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                    <i class="bi bi-arrow-left me-1"></i> Cancelar
                </a>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger shadow-sm border-start border-danger border-5">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                </div>
            }

            <div class="card shadow-sm border-0 border-top border-primary border-4" style="background-color: var(--bg-card, #ffffff);">
                <div class="card-body p-4">
                    <form asp-action="Editar" asp-route-id="@ViewBag.IdUsuario" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row g-3">

                            <!-- Nombre -->
                            <div class="col-md-12 mb-2">
                                <label asp-for="Nombre" class="form-label fw-bold">Nombre Completo <span class="text-danger">*</span></label>
                                <input asp-for="Nombre" class="form-control bg-transparent text-inherit" required />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-12 mb-2">
                                <label asp-for="Email" class="form-label fw-bold">Correo Electrónico <span class="text-danger">*</span></label>
                                <input asp-for="Email" type="email" class="form-control bg-transparent text-inherit" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            @if (esEstudiante)
                            {
                                <div class="col-md-6 mb-2">
                                    <label asp-for="Matricula" class="form-label fw-bold">Matrícula</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-transparent"><i class="bi bi-upc-scan"></i></span>
                                        <input asp-for="Matricula" class="form-control bg-transparent text-inherit" readonly title="La matrícula no debe modificarse frecuentemente." />
                                    </div>
                                    <span asp-validation-for="Matricula" class="text-danger small"></span>
                                </div>
                                <input type="hidden" asp-for="NumeroEmpleado" value="" />
                            }
                            else
                            {
                                <div class="col-md-6 mb-2">
                                    <label asp-for="NumeroEmpleado" class="form-label fw-bold">Número de Empleado</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-transparent"><i class="bi bi-person-badge"></i></span>
                                        <input asp-for="NumeroEmpleado" class="form-control bg-transparent text-inherit" />
                                    </div>
                                    <span asp-validation-for="NumeroEmpleado" class="text-danger small"></span>
                                </div>
                                <input type="hidden" asp-for="Matricula" value="" />
                            }

                            <div class="col-md-6 mb-3">
                                <label asp-for="Estado" class="form-label fw-bold">Estado del Usuario <span class="text-danger">*</span></label>
                                <select asp-for="Estado" class="form-select bg-transparent text-inherit" required>
                                    <option value="Activo">Activo</option>
                                    <option value="Inactivo">Inactivo</option>
                                </select>
                                <span asp-validation-for="Estado" class="text-danger small"></span>
                            </div>

                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary fw-bold shadow-sm rounded-pill">
                                <i class="bi bi-arrow-repeat me-2"></i> Actualizar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}