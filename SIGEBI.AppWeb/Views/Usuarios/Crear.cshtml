@model SIGEBI.Application.DTOs.UsuarioRequestDTO
@{
    ViewData["Title"] = "Registrar Nuevo Usuario";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold text-inherit"><i class="bi bi-person-plus text-primary me-2"></i> Registrar Usuario</h2>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                    <i class="bi bi-arrow-left me-1"></i> Volver a la lista
                </a>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger shadow-sm border-start border-danger border-5">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                </div>
            }

            <div class="card shadow-sm border-0 border-top border-primary border-4" style="background-color: var(--bg-card, #ffffff);">
                <div class="card-body p-4">
                    <form asp-action="Crear" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row g-3">
                            <!-- Tipo de Usuario -->
                            <div class="col-md-12 mb-2">
                                <label asp-for="TipoUsuario" class="form-label fw-bold text-inherit">Tipo de Usuario <span class="text-danger">*</span></label>
                                <select asp-for="TipoUsuario" class="form-select bg-transparent text-inherit custom-select-options" id="selectTipoUsuario" required>
                                    <option value="">-- Seleccione un Rol --</option>
                                    <option value="Estudiante">Estudiante</option>
                                    <option value="Docente">Docente</option>
                                    <option value="PersonalBibliotecario">Personal Bibliotecario</option>
                                    <option value="Auditor">Auditor</option>
                                    <option value="Administrador">Administrador</option>
                                </select>
                                <span asp-validation-for="TipoUsuario" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-2" id="divMatricula" style="display:none;">
                                <label asp-for="Matricula" class="form-label fw-bold text-inherit">Matrícula</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent text-inherit"><i class="bi bi-upc-scan"></i></span>
                                    <input asp-for="Matricula" class="form-control bg-transparent text-inherit" placeholder="Ej: 2025-2051" />
                                </div>
                                <span asp-validation-for="Matricula" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-2" id="divNumeroEmpleado" style="display:none;">
                                <label asp-for="NumeroEmpleado" class="form-label fw-bold text-inherit">Número de Empleado</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent text-inherit"><i class="bi bi-person-badge"></i></span>
                                    <input asp-for="NumeroEmpleado" class="form-control bg-transparent text-inherit" placeholder="Ej: EMP-001" />
                                </div>
                                <span asp-validation-for="NumeroEmpleado" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-2">
                                <label asp-for="Password" class="form-label fw-bold text-inherit">Contraseña Temporal <span class="text-danger">*</span></label>
                                <input asp-for="Password" type="password" class="form-control bg-transparent text-inherit" required />
                                <div class="form-text opacity-75">Suele ser igual a la matrícula/num. empleado.</div>
                            </div>

                            <!-- Nombre -->
                            <div class="col-md-12 mb-2">
                                <label asp-for="Nombre" class="form-label fw-bold text-inherit">Nombre Completo <span class="text-danger">*</span></label>
                                <input asp-for="Nombre" class="form-control bg-transparent text-inherit" required />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-12 mb-3">
                                <label asp-for="Email" class="form-label fw-bold text-inherit">Correo Electrónico <span class="text-danger">*</span></label>
                                <input asp-for="Email" type="email" class="form-control bg-transparent text-inherit" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary fw-bold shadow-sm rounded-pill">
                                <i class="bi bi-save me-2"></i> Guardar Usuario
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-inherit {
        color: inherit !important;
    }

    /* Fondo sólido para las opciones del selector en modo oscuro */
    .custom-select-options option {
        background-color: #2b3035;
        color: #f8f9fa;
    }

    html[data-theme='light'] .custom-select-options option {
        background-color: #ffffff;
        color: #212529;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('selectTipoUsuario').addEventListener('change', function () {
            var tipo = this.value.toLowerCase();
            var divMatricula = document.getElementById('divMatricula');
            var divNumEmpleado = document.getElementById('divNumeroEmpleado');

            document.getElementById('Matricula').value = '';
            document.getElementById('NumeroEmpleado').value = '';

            if (tipo === 'estudiante') {
                divMatricula.style.display = 'block';
                divNumEmpleado.style.display = 'none';
            } else if (tipo !== '') {
                divMatricula.style.display = 'none';
                divNumEmpleado.style.display = 'block';
            } else {
                divMatricula.style.display = 'none';
                divNumEmpleado.style.display = 'none';
            }
        });
    </script>
}