@model IEnumerable<SIGEBI.AppWeb.Models.Usuarios.UsuarioItemViewModel>
@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container mt-4">
    <!-- Encabezado y Botón de Crear -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h1 class="fw-bold"><i class="bi bi-people-fill text-primary me-2"></i> Gestión de Usuarios</h1>

        <!-- Este enlace apuntará a nuestra futura acción GET: /Usuarios/Crear -->
        <a asp-action="Crear" class="btn btn-primary rounded-pill shadow-sm fw-bold px-4">
            <i class="bi bi-person-plus-fill me-2"></i> Nuevo Usuario
        </a>
    </div>

    <!-- Alertas del sistema -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm border-start border-danger border-5">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm border-start border-success border-5">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <!-- Tabla de Resultados -->
    <div class="card shadow-sm border-0" style="background-color: var(--bg-card, #ffffff);">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-custom table-striped mb-0 align-middle">
                    <thead class="py-3 bg-dark text-white">
                        <tr>
                            <th class="py-3 px-4">ID</th>
                            <th class="py-3">Identificador</th>
                            <th class="py-3">Usuario</th>
                            <th class="py-3 text-center">Tipo</th>
                            <th class="py-3 text-center">Estado</th>
                            <th class="py-3 text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <!-- ID -->
                                    <td class="fw-bold px-4 text-muted">#@item.IdUsuario</td>

                                    <!-- Identificador (Matrícula o Empleado) -->
                                    <td class="fw-semibold">
                                        <i class="bi bi-upc-scan me-1 opacity-50"></i> @item.Identificador
                                    </td>

                                    <!-- Nombre y Correo combinados para un diseño más limpio -->
                                    <td>
                                        <div class="fw-bold text-dark">@item.Nombre</div>
                                        <div class="small text-muted"><i class="bi bi-envelope me-1"></i> @item.Email</div>
                                    </td>

                                    <!-- Tipo de Usuario -->
                                    <td class="text-center">
                                        <span class="badge border border-secondary text-secondary">@item.TipoUsuario</span>
                                    </td>

                                    <!-- Estado Visual -->
                                    <td class="text-center">
                                        @if (item.Estado == "Activo")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success">
                                                <i class="bi bi-check-circle me-1"></i>Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">
                                                <i class="bi bi-dash-circle me-1"></i>Inactivo
                                            </span>
                                        }
                                    </td>

                                    <!-- Botones de Acción -->
                                    <td class="text-center">
                                        <div class="btn-group shadow-sm">
                                            <!-- Botón Editar -->
                                            <a asp-action="Editar" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-outline-primary" title="Editar">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <!-- Botón Suspender/Reactivar -->
                                            <a asp-action="CambiarEstado" asp-route-id="@item.IdUsuario" class="btn btn-sm @(item.Estado == "Activo" ? "btn-outline-danger" : "btn-outline-success")" title="@(item.Estado == "Activo" ? "Suspender" : "Reactivar")">
                                                <i class="bi @(item.Estado == "Activo" ? "bi-person-x" : "bi-person-check")"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 opacity-75">
                                    <i class="bi bi-people fs-2 d-block mb-2 opacity-50"></i>
                                    No hay usuarios registrados en el sistema.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>