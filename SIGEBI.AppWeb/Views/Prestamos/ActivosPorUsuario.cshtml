@model IEnumerable<SIGEBI.AppWeb.Models.Prestamos.PrestamoItemViewModel>
@{
    ViewData["Title"] = "Préstamos Activos";
    bool esUsuarioRegular = ViewBag.EsUsuarioRegular ?? false;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-success"><i class="bi bi-journal-check"></i> Préstamos Activos</h2>
            @if (!esUsuarioRegular)
            {
                <p class="text-muted mb-0">Resultados para: <span class="fw-bold">@ViewBag.Busqueda</span></p>
            }
        </div>

        @if (esUsuarioRegular)
        {
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">Volver al Inicio</a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">Volver Atrás</a>
        }
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- Tabla estándar si hay resultados -->
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-custom table-striped mb-0 align-middle text-center">
                        <thead class="py-3 bg-success text-white">
                            <tr>
                                <th class="py-3 px-3">ID Préstamo</th>
                                <th class="py-3">Usuario</th>
                                <th class="py-3">Fecha Inicio</th>
                                <th class="py-3">Fecha Vencimiento</th>
                                <th class="py-3">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold px-3">#@item.IdPrestamo</td>
                                    <td>
                                        <div class="fw-bold">@item.NombreUsuario</div>
                                        <div class="small text-muted opacity-75">@(item.Matricula ?? item.NumeroEmpleado)</div>
                                    </td>
                                    <td>@item.FechaInicio.ToString("dd/MMM/yyyy")</td>
                                    <td>@item.FechaVencimiento.ToString("dd/MMM/yyyy")</td>
                                    <td>
                                        <span class="badge @(item.EstaVencido ? "bg-danger" : "bg-success")">
                                            @item.Estado
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- PANTALLA VACÍA PERSONALIZADA -->
        @if (esUsuarioRegular)
        {
            <div class="row justify-content-center mt-5">
                <div class="col-md-8">
                    <div class="card shadow-lg border-0 border-top border-info border-5 rounded-4 text-center p-5" style="background-color: var(--bg-card, #ffffff);">
                        <div class="display-1 text-info mb-4">
                            <i class="bi bi-stars"></i>
                        </div>
                        <h2 class="fw-bold mb-3">¡Todo al día! ✨</h2>
                        <p class="lead text-muted mb-4">No tienes libros pendientes por devolver ni préstamos activos en este momento.</p>
                        <p class="mb-5 opacity-75">¡Anímate a explorar el catálogo y sumérgete en tu próxima gran lectura! 📚</p>
                        <div>
                            <a asp-controller="Solicitudes" asp-action="Crear" class="btn btn-info text-white rounded-pill px-5 py-2 fw-bold shadow">
                                <i class="bi bi-plus-circle me-2"></i> Solicitar un Libro
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning shadow-sm border-start border-warning border-5 mt-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> No se encontraron préstamos activos para el usuario especificado.
            </div>
        }
    }
</div>