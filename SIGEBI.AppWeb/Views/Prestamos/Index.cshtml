@{
    ViewData["Title"] = "Gestión de Préstamos";
    var rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

    // Mapeo exacto de la matriz de permisos de los Casos de Uso
    bool esEstudianteODocente = rolUsuario == "Estudiante" || rolUsuario == "Docente";
    bool esPersonalBibliotecario = rolUsuario == "PersonalBibliotecario";
    bool esAdministrador = rolUsuario == "Administrador";
    bool esAuditor = rolUsuario == "Auditor";

    bool puedeAprobar = esPersonalBibliotecario; // CU-PRE-02
    bool puedeVerActivosGeneral = esPersonalBibliotecario || esAdministrador; // CU-PRE-03 (Vista Admin)
    bool puedeVerHistorial = esPersonalBibliotecario || esAdministrador || esAuditor; // CU-PRE-04
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h1 class="fw-bold"><i class="bi bi-journal-bookmark text-success"></i> Módulo de Préstamos</h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- VISTA EXCLUSIVA PARA ESTUDIANTES Y DOCENTES (CU-PRE-03) -->
    @if (esEstudianteODocente)
    {
        <div class="row justify-content-center my-4">
            <div class="col-md-9">
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                    <div class="card-header bg-success text-white py-4 px-4 text-center">
                        <h3 class="mb-1 fw-bold"><i class="bi bi-journal-check me-2"></i> Mis Préstamos Activos</h3>
                        <p class="mb-0 text-white-50 small">Consulta los recursos bibliotecarios que tienes asignados actualmente en posesión.</p>
                    </div>
                    <div class="card-body p-4 p-md-5 text-center">
                        <div class="display-4 text-success mb-3">
                            <i class="bi bi-person-badge"></i>
                        </div>
                        <h5 class="fw-bold mb-3">Verificación de Usuario</h5>
                        <p class="text-muted mb-4">Ingresa tu matrícula institucional o número de empleado para consultar el listado y las fechas límites de devolución de tus libros activos.</p>

                        <form asp-action="ActivosPorUsuario" method="get">
                            <div class="input-group input-group-lg mb-3 shadow-sm rounded-pill overflow-hidden border">
                                <span class="input-group-text bg-transparent border-0"><i class="bi bi-search text-muted ps-2"></i></span>
                                <input type="text" class="form-control border-0" name="identificador" required placeholder="Ej: 2024-1234 o EMP-001" autocomplete="off" />
                                <button class="btn btn-success px-5 fw-bold" type="submit">Consultar Activos</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- VISTA PARA EL PERSONAL BIBLIOTECARIO, ADMIN Y AUDITOR -->
        @if (puedeAprobar)
        {
            <div class="row g-4 mb-4">
                <div class="col-12">
                    <div class="card shadow p-3 border-start border-success border-5 transition-hover">
                        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <div>
                                <h4 class="card-title fw-bold">Aprobar Solicitud Pendiente</h4>
                                <p class="card-text text-muted mb-0">Valida las solicitudes de los usuarios y registra el inicio del préstamo físico en el sistema.</p>
                            </div>
                            <a asp-action="Aprobar" class="btn btn-success btn-lg px-5 rounded-pill shadow">
                                <i class="bi bi-check-circle me-2"></i> Realizar Aprobación
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row g-4">
            @if (puedeVerActivosGeneral)
            {
                <div class="col-md-6">
                    <div class="card h-100 shadow-sm transition-hover">
                        <div class="card-header bg-transparent border-0 pt-4 pb-0">
                            <h5 class="fw-bold text-success"><i class="bi bi-person-lines-fill me-2"></i> Activos por Usuario</h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="ActivosPorUsuario" method="get">
                                <div class="input-group mb-3 shadow-sm">
                                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                                    <input type="text" class="form-control" name="identificador" required placeholder="Ej: Matrícula o Empleado" />
                                    <button class="btn btn-success px-4" type="submit">Buscar</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card h-100 shadow-sm transition-hover">
                        <div class="card-header bg-transparent border-0 pt-4 pb-0">
                            <h5 class="fw-bold text-info"><i class="bi bi-journal-text me-2"></i> Activos por Recurso</h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="ActivosPorRecurso" method="get">
                                <div class="input-group mb-3 shadow-sm">
                                    <span class="input-group-text bg-white"><i class="bi bi-upc-scan"></i></span>
                                    <input type="text" class="form-control" name="isbnLibro" required placeholder="Ej: Código ISBN del Libro" />
                                    <button class="btn btn-info text-white px-4" type="submit">Buscar</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }

            @if (puedeVerHistorial)
            {
                <div class="col-md-6">
                    <div class="card h-100 shadow-sm transition-hover">
                        <div class="card-header bg-transparent border-0 pt-4 pb-0">
                            <h5 class="fw-bold text-secondary"><i class="bi bi-clock-history me-2"></i> Historial de Usuario</h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="HistorialPorUsuario" method="get">
                                <div class="input-group mb-3 shadow-sm">
                                    <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                                    <input type="text" class="form-control" name="identificador" required placeholder="Ej: Matrícula o Empleado" />
                                    <button class="btn btn-secondary px-4" type="submit">Revisar</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card h-100 shadow-sm transition-hover">
                        <div class="card-header bg-transparent border-0 pt-4 pb-0">
                            <h5 class="fw-bold text-secondary"><i class="bi bi-archive me-2"></i> Historial de Recurso</h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="HistorialPorRecurso" method="get">
                                <div class="input-group mb-3 shadow-sm">
                                    <span class="input-group-text bg-white"><i class="bi bi-journal-code"></i></span>
                                    <input type="text" class="form-control" name="isbnLibro" required placeholder="Ej: Código ISBN del Libro" />
                                    <button class="btn btn-secondary px-4" type="submit">Revisar</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .transition-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }
</style>