@model IEnumerable<SIGEBI.AppWeb.Models.Prestamos.PrestamoItemViewModel>
@{
    ViewData["Title"] = "Mis Préstamos";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h1 class="fw-bold"><i class="bi bi-journal-bookmark text-success"></i> Mis Préstamos Activos</h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm border-start border-danger border-5">
            <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <!-- Tabla estándar si hay préstamos activos -->
        <div class="card shadow-sm border-0 border-top border-success border-4 mb-4">
            <div class="card-body p-4">
                <p class="text-muted mb-4 opacity-75">Este es el listado de los recursos bibliotecarios que tienes actualmente en tu posesión. Recuerda devolverlos a tiempo para evitar multas.</p>

                <div class="table-responsive">
                    <table class="table table-hover table-custom table-striped mb-0 align-middle text-center">
                        <thead class="py-3 bg-success text-white">
                            <tr>
                                <!-- Cabecera de ID eliminada. Se agrega el Recurso. -->
                                <th class="py-3 px-3 text-start">Recurso Prestado</th>
                                <th class="py-3">Fecha Inicio</th>
                                <th class="py-3">Fecha Vencimiento</th>
                                <th class="py-3">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <!-- Celda de ID eliminada. Se muestra el nombre del libro. -->
                                    <td class="text-start fw-bold px-3">
                                        <i class="bi bi-book-half text-success me-2"></i>@item.TituloLibro
                                    </td>
                                    <td>@item.FechaInicio.ToString("dd/MMM/yyyy")</td>
                                    <td class="fw-semibold">@item.FechaVencimiento.ToString("dd/MMM/yyyy")</td>
                                    <td>
                                        @if (item.EstaVencido)
                                        {
                                            <span class="badge bg-danger shadow-sm py-2 px-3">
                                                <i class="bi bi-alarm me-1"></i> Vencido (@item.DiasRetraso días)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success shadow-sm py-2 px-3">
                                                <i class="bi bi-check-circle me-1"></i> @item.Estado
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Si la lista está vacía, mostramos el mensaje bonito -->
        <div class="row justify-content-center mt-5">
            <div class="col-md-8">
                <div class="card shadow-lg border-0 border-top border-info border-5 rounded-4 text-center p-5" style="background-color: var(--bg-card, #ffffff);">
                    <div class="display-1 text-info mb-4">
                        <i class="bi bi-stars"></i>
                    </div>
                    <h2 class="fw-bold mb-3">¡Todo al día! ✨</h2>
                    <p class="lead text-muted mb-4">No tienes libros pendientes por devolver ni préstamos activos en este momento.</p>
                    <p class="mb-5 opacity-75">¡Anímate a explorar el catálogo y sumérgete en tu próxima gran lectura! 📚</p>
                    <div>
                        <a asp-controller="Catalogo" asp-action="Index" class="btn btn-info text-white rounded-pill px-5 py-2 fw-bold shadow transition-hover">
                            <i class="bi bi-search me-2"></i> Explorar Catálogo
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .table-custom th {
        letter-spacing: 0.05em;
        text-transform: uppercase;
        font-size: 0.85rem;
    }

    .transition-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .transition-hover:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }
</style>