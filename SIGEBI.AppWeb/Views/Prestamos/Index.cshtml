@model IEnumerable<SIGEBI.AppWeb.Models.Prestamos.PrestamoItemViewModel>
@{
    ViewData["Title"] = "Gestión de Préstamos";
    var rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

    bool esEstudianteODocente = rolUsuario == "Estudiante" || rolUsuario == "Docente";
    bool esPersonalBibliotecario = rolUsuario == "PersonalBibliotecario";
    bool esAdministrador = rolUsuario == "Administrador";
    bool esAuditor = rolUsuario == "Auditor";

    bool puedeAprobar = esPersonalBibliotecario;
    bool puedeVerActivosGeneral = esPersonalBibliotecario || esAdministrador;
    bool puedeVerHistorial = esPersonalBibliotecario || esAdministrador || esAuditor;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h1 class="fw-bold"><i class="bi bi-journal-bookmark text-success"></i> Módulo de Préstamos</h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- VISTA EXCLUSIVA PARA ESTUDIANTES Y DOCENTES -->
    @if (esEstudianteODocente)
    {
        if (Model != null && Model.Any())
        {
            <!-- Si tiene préstamos, mostramos la tabla directamente -->
            <div class="card shadow-sm border-0 border-top border-success border-4 mb-4">
                <div class="card-body p-4">
                    <h4 class="fw-bold text-success mb-3"><i class="bi bi-journal-check me-2"></i> Mis Préstamos Activos</h4>
                    <p class="text-muted mb-4 opacity-75">Este es el listado de los recursos bibliotecarios que tienes actualmente en posesión.</p>

                    <div class="table-responsive">
                        <table class="table table-hover table-custom table-striped mb-0 align-middle text-center">
                            <thead class="py-3 bg-success text-white">
                                <tr>
                                    <th class="py-3 px-3">ID Préstamo</th>
                                    <th class="py-3">Fecha Inicio</th>
                                    <th class="py-3">Fecha Vencimiento</th>
                                    <th class="py-3">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="fw-bold px-3">#@item.IdPrestamo</td>
                                        <td>@item.FechaInicio.ToString("dd/MMM/yyyy")</td>
                                        <td>@item.FechaVencimiento.ToString("dd/MMM/yyyy")</td>
                                        <td>
                                            <span class="badge @(item.EstaVencido ? "bg-danger" : "bg-success")">
                                                @item.Estado
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Si la lista está vacía, mostramos el mensaje bonito -->
            <div class="row justify-content-center mt-5">
                <div class="col-md-8">
                    <div class="card shadow-lg border-0 border-top border-info border-5 rounded-4 text-center p-5" style="background-color: var(--bg-card, #ffffff);">
                        <div class="display-1 text-info mb-4">
                            <i class="bi bi-stars"></i>
                        </div>
                        <h2 class="fw-bold mb-3">¡Todo al día! ✨</h2>
                        <p class="lead text-muted mb-4">No tienes libros pendientes por devolver ni préstamos activos en este momento.</p>
                        <p class="mb-5 opacity-75">¡Anímate a explorar el catálogo y sumérgete en tu próxima gran lectura! 📚</p>
                        <div>
                            <a asp-controller="Solicitudes" asp-action="Crear" class="btn btn-info text-white rounded-pill px-5 py-2 fw-bold shadow">
                                <i class="bi bi-plus-circle me-2"></i> Solicitar un Libro
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <!-- VISTA PARA EL PERSONAL BIBLIOTECARIO, ADMIN Y AUDITOR -->
        @if (puedeAprobar)
        {
            <div class="row g-4 mb-4">
                <div class="col-12">
                    <div class="card shadow p-3 border-start border-success border-5 transition-hover">
                        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <div>
                                <h4 class="card-title fw-bold">Aprobar Solicitud Pendiente</h4>
                                <p class="card-text text-muted mb-0">Valida las solicitudes de los usuarios y registra el inicio del préstamo físico en el sistema.</p>
                            </div>
                            <a asp-action="Aprobar" class="btn btn-success btn-lg px-5 rounded-pill shadow">
                                <i class="bi bi-check-circle me-2"></i> Realizar Aprobación
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row g-4">
            @if (puedeVerActivosGeneral)
            {
                <div class="col-md-6">
                    <div class="card h-100 shadow-sm transition-hover">
                        <div class="card-header bg-transparent border-0 pt-4 pb-0">
                            <h5 class="fw-bold text-success"><i class="bi bi-person-lines-fill me-2"></i> Activos por Usuario</h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="ActivosPorUsuario" method="get">
                                <div class="input-group mb-3 shadow-sm">
                                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                                    <input type="text" class="form-control" name="identificador" required placeholder="Ej: Matrícula o Empleado" />
                                    <button class="btn btn-success px-4" type="submit">Buscar</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card h-100 shadow-sm transition-hover">
                        <div class="card-header bg-transparent border-0 pt-4 pb-0">
                            <h5 class="fw-bold text-info"><i class="bi bi-journal-text me-2"></i> Activos por Recurso</h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="ActivosPorRecurso" method="get">
                                <div class="input-group mb-3 shadow-sm">
                                    <span class="input-group-text bg-white"><i class="bi bi-upc-scan"></i></span>
                                    <input type="text" class="form-control" name="isbnLibro" required placeholder="Ej: Código ISBN del Libro" />
                                    <button class="btn btn-info text-white px-4" type="submit">Buscar</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }

            @if (puedeVerHistorial)
            {
                <div class="col-md-6">
                    <div class="card h-100 shadow-sm transition-hover">
                        <div class="card-header bg-transparent border-0 pt-4 pb-0">
                            <h5 class="fw-bold text-secondary"><i class="bi bi-clock-history me-2"></i> Historial de Usuario</h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="HistorialPorUsuario" method="get">
                                <div class="input-group mb-3 shadow-sm">
                                    <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                                    <input type="text" class="form-control" name="identificador" required placeholder="Ej: Matrícula o Empleado" />
                                    <button class="btn btn-secondary px-4" type="submit">Revisar</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card h-100 shadow-sm transition-hover">
                        <div class="card-header bg-transparent border-0 pt-4 pb-0">
                            <h5 class="fw-bold text-secondary"><i class="bi bi-archive me-2"></i> Historial de Recurso</h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="HistorialPorRecurso" method="get">
                                <div class="input-group mb-3 shadow-sm">
                                    <span class="input-group-text bg-white"><i class="bi bi-journal-code"></i></span>
                                    <input type="text" class="form-control" name="isbnLibro" required placeholder="Ej: Código ISBN del Libro" />
                                    <button class="btn btn-secondary px-4" type="submit">Revisar</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .transition-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }
</style>