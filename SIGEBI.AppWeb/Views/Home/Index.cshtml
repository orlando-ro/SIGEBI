@{
    ViewData["Title"] = "Inicio";
    var rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    bool esPersonalAutorizado = rolUsuario == "PersonalBibliotecario" || rolUsuario == "Administrador" || rolUsuario == "Auditor";
    bool esAdminOAuditor = rolUsuario == "Administrador" || rolUsuario == "Auditor";
    bool esEstudianteODocente = rolUsuario == "Estudiante" || rolUsuario == "Docente";

    // Validaciones
    bool puedeVerSolicitudes = rolUsuario != "Auditor";
    bool puedeVerPenalizaciones = rolUsuario != "Auditor";
}

<div class="container text-center mt-5 pt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="display-4 fw-bold text-primary mb-4">
                <i class="bi bi-book-half"></i> Bienvenido a SIGEBI
            </h1>
            <p class="lead mb-5">
                Sistema de Gestión de Bibliotecas del Instituto Tecnológico de Las Américas (ITLA).
            </p>

            @if (!User.Identity!.IsAuthenticated)
            {
                <div class="card shadow-sm border-0 p-4 rounded-4">
                    <h5 class="fw-semibold mb-3">Acceso Restringido</h5>
                    <p class="mb-4 opacity-75">Para acceder a los módulos de préstamos, devoluciones y administración de recursos, por favor inicie sesión con sus credenciales institucionales.</p>
                    <div>
                        <a asp-controller="Acceso" asp-action="Login" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Ir al Login
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0 border-start border-success border-5 p-4 rounded-4 text-start">
                    <div class="d-flex align-items-center">
                        <div class="fs-1 text-success me-4 d-none d-sm-block">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-1">¡Hola, @User.Identity.Name!</h4>
                            <p class="opacity-75 mb-4">Has iniciado sesión correctamente en el sistema. ¿Qué deseas hacer hoy?</p>

                            <!-- Contenedor con los accesos directos -->
                            <div class="d-flex flex-wrap gap-3">

                                <a asp-controller="Prestamos" asp-action="Index" class="btn btn-success rounded-pill px-4 shadow-sm">
                                    <i class="bi bi-journal-bookmark me-2"></i>
                                    @(esEstudianteODocente ? "Consultar Préstamos Activos" : "Panel de Préstamos")
                                </a>

                                @if (puedeVerSolicitudes)
                                {
                                    <a asp-controller="Solicitudes" asp-action="Index" class="btn btn-primary rounded-pill px-4 shadow-sm">
                                        <i class="bi bi-inbox me-2"></i> Panel de Solicitudes
                                    </a>
                                }

                                @if (esPersonalAutorizado)
                                {
                                    <a asp-controller="Devoluciones" asp-action="Index" class="btn btn-info text-white rounded-pill px-4 shadow-sm">
                                        <i class="bi bi-box-arrow-in-left me-2"></i> Panel de Devoluciones
                                    </a>
                                }

                                <!-- NUEVO: Penalizaciones Dinámicas -->
                                @if (puedeVerPenalizaciones)
                                {
                                    <a asp-controller="Penalizaciones" asp-action="Index" class="btn btn-danger text-white rounded-pill px-4 shadow-sm">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                        @(esEstudianteODocente ? "Mis Penalizaciones" : "Panel de Penalizaciones")
                                    </a>
                                }

                                @if (esPersonalAutorizado)
                                {
                                    <a asp-controller="Reportes" asp-action="Index" class="btn btn-dark text-white rounded-pill px-4 shadow-sm">
                                        <i class="bi bi-bar-chart-line-fill me-2"></i> Reportes y Estadísticas
                                    </a>
                                }

                                @if (esAdminOAuditor)
                                {
                                    <a asp-controller="Auditoria" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4 shadow-sm fw-bold bg-white">
                                        <i class="bi bi-shield-lock-fill me-2"></i> Log de Sistema
                                    </a>
                                }
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>